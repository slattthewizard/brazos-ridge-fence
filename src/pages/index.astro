    <div class="steps-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
      <div style="background:#fff;border-radius:16px;padding:34px 26px;box-shadow:0 4px 18px rgba(42,39,36,0.08);">
        <div style="width:54px;height:54px;border-radius:50%;background:#A6491F;color:#fff;font-family:'Oswald',sans-serif;font-size:22px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">1</div>
        <h3 style="font-family:'Oswald',sans-serif;font-size:18px;font-weight:800;color:#2A2724;margin:0 0 10px;">Walk the line</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#5A6B76;margin:0;">We come out, walk your fence line with you, talk about what you're keeping in or out, and measure the whole run.</p>
