---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Game Fence Builder Waco TX | 24/7 | Brazos Ridge Fence Co."
  description="Game fence and ranch fencing built right in Waco and Central Texas. High fence, pipe, barbed wire and gates. Free written estimates. Call (509) 351-8404."
  canonical="https://brazosridgefence.com/"
>
<Fragment slot="head">
<script type="application/ld+json">{"@type": ["Plumber", "LocalBusiness"], "@id": "https://brazosridgefence.com/#organization", "name": "Brazos Ridge Fence Co.", "url": "https://brazosridgefence.com", "logo": {"@type": "ImageObject", "url": "https://brazosridgefence.com/images/og-image.webp"}, "priceRange": "$$", "telephone": "(509) 351-8404", "email": "info@brazosridgefence.com", "address": {"@type": "PostalAddress", "addressLocality": "Waco", "addressRegion": "TX", "addressCountry": "US"}, "geo": {"@type": "GeoCoordinates", "latitude": 31.5493, "longitude": -97.1467}, "areaServed": [{"@type": "City", "name": "Waco", "addressRegion": "TX"}, {"@type": "City", "name": "China Spring", "addressRegion": "TX"}, {"@type": "City", "name": "Crawford", "addressRegion": "TX"}, {"@type": "City", "name": "McGregor", "addressRegion": "TX"}, {"@type": "City", "name": "Valley Mills", "addressRegion": "TX"}, {"@type": "City", "name": "Lorena", "addressRegion": "TX"}, {"@type": "City", "name": "West", "addressRegion": "TX"}], "@context": "https://schema.org", "description": "Game fence and ranch fencing built right in Waco and Central Texas. High fence, pipe, barbed wire and gates. Free written estimates. Call (509) 351-8404.", "image": "https://brazosridgefence.com/images/og-image.webp", "hasOfferCatalog": {"@type": "OfferCatalog", "name": "Ranch Fencing Services", "itemListElement": [{"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Game & High Fence Installation"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Pipe Fence & Corrals"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Barbed Wire Fencing"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Ranch Entrance Gates"}}]}}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "WebSite", "@id": "https://brazosridgefence.com/#website", "url": "https://brazosridgefence.com", "name": "Brazos Ridge Fence Co.", "publisher": {"@id": "https://brazosridgefence.com/#organization"}}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How much does a game fence cost in Waco?", "acceptedAnswer": {"@type": "Answer", "text": "Most 8 foot game fence in Central Texas runs $4 to $8 per foot installed, which works out to roughly $21,000 to $42,000 per mile. Heavy brush clearing, rocky ground and extra gates push the number up, so we quote it after walking your line."}}, {"@type": "Question", "name": "Do you charge extra for after-hours emergency calls?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, after-hours and weekend emergency calls carry a $150 to $250 trip fee on top of the repair, depending on how far out you are. If cattle are out on a road we treat it as a priority call and we'll usually have wire back up the same night."}}, {"@type": "Question", "name": "How tall does a game fence need to be for deer?", "acceptedAnswer": {"@type": "Answer", "text": "Whitetail need a fence at least 8 feet tall to be reliably contained, and Texas high fence rules apply if you're managing deer behind wire. We build game fence at 8 feet with fixed knot wire, which also does a good job slowing feral hogs."}}, {"@type": "Question", "name": "How long does it take to fence 10 acres?", "acceptedAnswer": {"@type": "Answer", "text": "A 10 acre perimeter is roughly 2,600 feet of fence. With normal clearing, a crew typically finishes barbed wire in 3 to 5 working days, while game fence or pipe fence takes longer because of the heavier posts and wire."}}, {"@type": "Question", "name": "Do you clear brush along the fence line?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, we clear cedar, mesquite and brush along the fence line as part of most jobs, and we price it separately so you can see the cost. A clean line makes for a straighter fence and a lot less maintenance down the road."}}, {"@type": "Question", "name": "What areas do you serve?", "acceptedAnswer": {"@type": "Answer", "text": "We work out of Waco and cover McLennan, Bosque and Falls counties, including China Spring, Crawford, McGregor, Valley Mills, Lorena and West. Estimates are free and in writing anywhere in that service area."}}]}</script>
<style is:global>
  .rich p { font-size: 16px; line-height: 1.8; color: #555; margin: 0 0 16px; }
  .rich ul { padding-left: 20px; margin: 0 0 16px; }
  .rich li { font-size: 16px; line-height: 1.8; color: #555; margin-bottom: 8px; }
  .rich strong { color: #2E2A25; }
  .rich a { color: #C68A2E; font-weight: 600; text-decoration: none; }
  .rich a:hover { text-decoration: underline; }
</style>
</Fragment>

<!-- HERO -->
<section style="position:relative;min-height:560px;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;">
  <img src="/images/hero-panorama.webp" alt="Central Texas landscape" width="2000" height="950" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="eager" fetchpriority="high">
  <div style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(42,39,36,0.55) 0%, rgba(42,39,36,0.25) 55%, rgba(42,39,36,0.45) 100%);"></div>
  <div style="position:relative;max-width:880px;padding:96px 24px 130px;">
    <span style="display:inline-block;margin-bottom:18px;padding:7px 18px;border-radius:999px;font-family:'Oswald',sans-serif;font-size:12px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;background:rgba(255,255,255,0.14);color:#fff;border:1px solid rgba(255,255,255,0.35);backdrop-filter:blur(3px);">Family-Run · Central Texas</span>
    <h1 style="font-family:'Oswald',sans-serif;font-weight:800;color:#fff;line-height:1.08;letter-spacing:-0.015em;font-size:clamp(32px,5vw,58px);margin:0 0 18px;text-shadow:0 2px 24px rgba(42,39,36,0.45);">Game Fence and Ranch Fencing Built to Hold, Right Here in Waco</h1>
    <p style="font-size:18px;line-height:1.7;color:rgba(255,255,255,0.92);max-width:640px;margin:0 auto 30px;text-shadow:0 1px 12px rgba(42,39,36,0.5);">Brazos Ridge Fence Co. builds game fence, pipe fence, barbed wire and ranch gates for landowners across McLennan, Bosque and Falls counties. We answer the phone 24/7 for cattle-out and storm emergencies, and every estimate is free and in writing.</p>
    <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
      <a href="tel:+15093518404" class="btn-green" style="font-size:15px;padding:16px 38px;">Call Now — (509) 351-8404</a>
      <a href="/#contact" class="btn-white-outline" style="font-size:15px;">Get My Free Written Estimate</a>
    </div>
  </div>
  <svg class="swoosh" style="position:absolute;bottom:0;left:0;" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0,70 C360,10 1080,10 1440,70 L1440,70 L0,70 Z" fill="#ffffff"/></svg>
</section>

<!-- INTRO -->
<section style="padding:84px 24px 64px;background:#fff;">
  <div class="intro-grid" style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:0.9fr 1.1fr;gap:64px;align-items:center;">
    <div style="position:relative;">
      <div style="border-radius:18px;overflow:hidden;box-shadow:0 24px 56px rgba(42,39,36,0.22);aspect-ratio:1/1;">
        <img src="/images/about.webp" alt="Brazos Ridge Fence Co. service crew" width="1024" height="1024" style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
      </div>
      <div style="position:absolute;bottom:-18px;right:-14px;background:#A6491F;color:#fff;border-radius:14px;padding:14px 22px;box-shadow:0 10px 26px rgba(166,73,31,0.4);">
        <p style="font-family:'Oswald',sans-serif;font-size:20px;font-weight:800;margin:0;line-height:1;">24/7</p>
        <p style="font-size:11.5px;font-weight:700;margin:4px 0 0;letter-spacing:0.06em;text-transform:uppercase;">Emergency Line</p>
      </div>
    </div>
    <div>
      <span class="kicker">Ranch fencing done the Central Texas way</span>
      <h2 class="section-heading" style="font-size:clamp(26px,3.4vw,40px);margin:0 0 18px;">Fence Builders Who Know Cattle, Deer and Blackland Clay</h2>
      <div class="rich"><p>Brazos Ridge Fence Co. builds working fence for working land. From an 8 foot <a href="/game-fence-installation-waco/">game fence</a> around a whitetail place to five strands of <a href="/barbed-wire-fence-waco/">barbed wire</a> across a cow-calf pasture, we build it the way old fence hands did, with deep-set corner posts, real H-braces and wire stretched until it hums. We also weld <a href="/pipe-fence-waco/">pipe fence and corrals</a> and hang <a href="/ranch-entrance-gates-waco/">ranch entrance gates</a> that still swing straight ten years on.</p><p>We give you real numbers up front, not a sales pitch. Barbed wire usually runs $2 to $4 per foot, net wire $3 to $5, game fence $4 to $8 and pipe fence $12 to $25, and our <a href="/ranch-fence-cost/">ranch fence cost guide</a> breaks all of it down by the foot and by the mile. If a storm drops a tree on your fence or cattle get out on the highway, our emergency line answers 24/7 at (509) 351-8404.</p></div>
      <a href="/about/" class="btn-blue" style="margin-top:10px;">More About Us</a>
    </div>
  </div>
</section>
<style>
  @media (max-width: 900px) { .intro-grid { grid-template-columns: 1fr !important; gap: 44px !important; } }
</style>

<!-- TILES -->
<section id="services" style="padding:72px 24px 84px;background:#F5EDDF;">
  <div style="max-width:1120px;margin:0 auto;text-align:center;">
    <span class="kicker">Fast Emergency Service Available</span>
    <h2 class="section-heading" style="font-size:clamp(26px,3.4vw,40px);margin:0 0 40px;">What's Going On With Your Fence?</h2>
    <div class="tile-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px;">
      <a href="/blog/cattle-getting-out-of-fence/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/tile-1.webp" alt="Cattle standing near a gap in a loose barbed wire fence on a Central Texas ranch" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Cattle keep getting out</span>
      </a>
      <a href="/blog/feral-hog-fence-damage/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/tile-2.webp" alt="Bottom wires of a net wire fence pushed up and torn by feral hogs" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Feral hogs tearing up fence</span>
      </a>
      <a href="/blog/leaning-fence-posts/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/tile-3.webp" alt="Wood fence post leaning over with slack wire on a fence line" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Leaning or rotten posts</span>
      </a>
      <a href="/blog/storm-damaged-fence-repair/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/tile-4.webp" alt="Fence line flattened by a fallen tree after a Texas storm" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Storm knocked your fence down</span>
      </a>
      <a href="/game-fence-installation-waco/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/service-1.webp" alt="Eight foot tall game fence running along a cleared ranch fence line near Waco" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Game and high fence installation</span>
      </a>
      <a href="/pipe-fence-waco/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/service-2.webp" alt="Welded steel pipe fence around a cattle pen on a ranch" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Pipe fence and corrals</span>
      </a>
      <a href="/barbed-wire-fence-waco/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/service-3.webp" alt="Five strand barbed wire fence stretched tight between wood posts in a pasture" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Barbed wire fencing</span>
      </a>
      <a href="/ranch-entrance-gates-waco/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(42,39,36,0.1);">
        <img src="/images/service-4.webp" alt="Steel ranch entrance gate with a pipe arch at the front of a Central Texas property" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Oswald',sans-serif;font-size:14.5px;font-weight:800;color:#2A2724;padding:14px 12px;">Ranch entrance gates</span>
      </a>
    </div>
  </div>
</section>
<style>
  @media (max-width: 1000px) { .tile-grid { grid-template-columns: repeat(2,1fr) !important; } }
  @media (max-width: 520px) { .tile-grid { grid-template-columns: 1fr !important; } }
</style>

<!-- SERVICE CARDS -->
<section style="padding:0 24px 80px;background:#F5EDDF;">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="svc-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
      <a href="/game-fence-installation-waco/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);">
        <h3 style="font-family:'Oswald',sans-serif;font-size:20px;font-weight:800;color:#2A2724;margin:0 0 10px;">Game & High Fence Installation</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">Eight foot high fence for whitetail, exotics and hog control, built with fixed knot wire and braced corners that stay tight for decades. We handle clearing, layout and water gaps so the whole perimeter holds.</p>
        <span style="font-size:13px;font-weight:700;color:#A6491F;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
      <a href="/pipe-fence-waco/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);">
        <h3 style="font-family:'Oswald',sans-serif;font-size:20px;font-weight:800;color:#2A2724;margin:0 0 10px;">Pipe Fence & Corrals</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">Welded pipe fencing, corrals and working pens built from new or used oilfield pipe, set in concrete and welded on site. It's the toughest fence you can put around horses and cattle.</p>
        <span style="font-size:13px;font-weight:700;color:#A6491F;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
      <a href="/barbed-wire-fence-waco/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);">
        <h3 style="font-family:'Oswald',sans-serif;font-size:20px;font-weight:800;color:#2A2724;margin:0 0 10px;">Barbed Wire Fencing</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">Four, five and six strand barbed wire with class 3 galvanized wire and proper H-brace corners. Most pastures run $2 to $4 per foot installed, and we'll walk the line with you before we quote it.</p>
        <span style="font-size:13px;font-weight:700;color:#A6491F;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
      <a href="/ranch-entrance-gates-waco/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);">
        <h3 style="font-family:'Oswald',sans-serif;font-size:20px;font-weight:800;color:#2A2724;margin:0 0 10px;">Ranch Entrance Gates</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">Pipe entrance gates, overhead arches and cattle guards that swing true and make the front of your place look right. We build them to fit your drive, from a simple 16 foot gate to a full custom entry.</p>
        <span style="font-size:13px;font-weight:700;color:#A6491F;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
    </div>
  </div>
</section>
<style>
  @media (max-width: 1000px) { .svc-grid { grid-template-columns: repeat(2,1fr) !important; } }
  @media (max-width: 600px) { .svc-grid { grid-template-columns: 1fr !important; } }
</style>

<!-- WHY -->
<section style="padding:84px 24px;background:#fff;">
  <div class="why-grid" style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1.1fr 0.9fr;gap:64px;align-items:center;">
    <div>
      <span class="kicker">What Makes Us Different</span>
      <h2 class="section-heading" style="font-size:clamp(26px,3.4vw,40px);margin:0 0 28px;">Why Landowners Around Waco Call Brazos Ridge</h2>
      <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:20px;">
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#A6491F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Oswald',sans-serif;font-size:17px;font-weight:800;color:#2A2724;margin:0 0 4px;">Free written estimates, priced by the foot</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5A6B76;margin:0;">We walk your fence line, measure it and hand you a written number per foot. No verbal guesses that grow later.</p>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#A6491F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Oswald',sans-serif;font-size:17px;font-weight:800;color:#2A2724;margin:0 0 4px;">24/7 line for cattle-out and storm damage</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5A6B76;margin:0;">Cattle on the road at 2 a.m. is a liability problem, not just a fence problem. Call (509) 351-8404 any hour and we'll get wire back up.</p>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#A6491F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Oswald',sans-serif;font-size:17px;font-weight:800;color:#2A2724;margin:0 0 4px;">Built for Central Texas ground</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5A6B76;margin:0;">Blackland clay swells, river bottoms flood and limestone eats augers. We set posts and water gaps for the dirt you actually have.</p>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:flex-start;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#A6491F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <p style="font-family:'Oswald',sans-serif;font-size:17px;font-weight:800;color:#2A2724;margin:0 0 4px;">Local to Waco, built for Texas ground</p>
              <p style="font-size:14.5px;line-height:1.7;color:#5A6B76;margin:0;">We're a Waco outfit working McLennan, Bosque and Falls counties. Our crews carry insurance and our work carries our name.</p>
            </div>
          </li>
      </ul>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;">
      <div style="border-radius:18px;overflow:hidden;box-shadow:0 18px 44px rgba(42,39,36,0.2);aspect-ratio:4/5;">
        <img src="/images/hero-800.webp" alt="Brazos Ridge Fence Co. at work" width="800" height="800" style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div style="background:#C68A2E;border-radius:14px;padding:24px;text-align:center;">
          <p style="font-family:'Oswald',sans-serif;font-size:26px;font-weight:800;color:#fff;margin:0;line-height:1;">$0</p>
          <p style="font-size:12.5px;font-weight:700;color:rgba(255,255,255,0.85);margin:6px 0 0;letter-spacing:0.05em;text-transform:uppercase;">Estimate Fee</p>
        </div>
        <div style="background:#A6491F;border-radius:14px;padding:24px;text-align:center;">
          <p style="font-family:'Oswald',sans-serif;font-size:26px;font-weight:800;color:#fff;margin:0;line-height:1;">Same Day</p>
